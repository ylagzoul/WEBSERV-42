server {
    listen 8000;
    
    client_max_body_size 15M;
    
    root /home/abouhki/realWebserv/dashboard;
    index index.html;

    location / {
        methods GET POST;
        upload_path /uploads;
        autoindex on;
    }


    location /cgi-bin/ {
        root /home/abouhki/realWebserv/dashboard/cgi-bin/;

        methods GET POST;
        cgi_data .pl /usr/bin/perl;
        cgi_data .py /usr/bin/python3;
        cgi_data .php /usr/bin/php;
    }
    
    location /redirect {
        return 301 http://localhost:8080/index.html;
    }
}