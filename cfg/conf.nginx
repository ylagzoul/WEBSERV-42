server {
    listen 127.0.0.1:3050;
    methods GET POST DELETE;
    client_max_body_size 50M;
    error_page 400 /errors/400.html;
    error_page 403 /errors/403.html;  
    error_page 404 /errors/404.html;
    error_page 405 /errors/405.html;
    root /home/mradouan/Desktop/WEBSERV-42/dashboard;
    index index.html;

    location / {
        error_page 400 /errors/400.html;
        methods GET POST;
        upload_path /uploads;
        autoindex on;
    }
    location /website {
        index login.html;
        root /home/mradouan/Desktop/WEBSERV-42/dashboard/website;
        authInfo /website/login.html /website/dashboard.html /website/profile.html;

    }
    location /cgi-bin/ {
        error_page 500 /errors/500.html;
        error_page 501 /errors/501.html;
        error_page 502 /errors/502.html;
        error_page 504 /errors/504.html;
        root /home/mradouan/Desktop/WEBSERV-42/dashboard/cgi-bin/;

        methods GET POST;
        cgi_data .pl /usr/bin/perl;
        cgi_data .py /usr/bin/python3;
        cgi_data .php /home/mradouan/php/bin/php-cgi;
    }
    
    location /redirect {
        return 301 /website/;
    }
}