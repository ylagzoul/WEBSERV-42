server {
    listen 127.0.0.1:3050;
    root /home/mradouan/Desktop/WEBSERV-42;
    cgi_data .bla cgi_tester;

    location / {
        methods GET;
        root /home/mradouan/Desktop/WEBSERV-42;
        index index.html;
        autoindex on;
    }

    location /post_body {
        methods POST;
        upload_path /;
        root /home/mradouan/Desktop/WEBSERV-42;
        client_max_body_size 100M;
    }

    location /directory/ {
        client_max_body_size 100M;
        methods GET;
        root /home/mradouan/Desktop/WEBSERV-42/YoupiBanane;
        index youpi.bad_extension;
    }
}