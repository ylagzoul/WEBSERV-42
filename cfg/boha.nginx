server {
    listen 127.0.0.1:3050;
    root /home/abouhki/realWebserv;
    methods GET;
    error_page 400 /errors/400.html;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    error_page 504 /errors/504.html;
    autoindex on;

    location / {
        methods GET POST DELETE;
        index /index.htm;
        error_page 500 /errors/500.html;
        error_page 400 /errors/400.html;
        
        upload_path /upload;
        root /home/abouhki/realWebserv;
        cgi_data .php /usr/bin/php-cgi;
        cgi_data .py /usr/bin/python3;
        autoindex on;
    }

    location /portf {
        methods GET POST;
        upload_path /html;
        index index.html;
        error_page 400 /errors/400.html;
        error_page 404 /errors/404.html;
        root /home/abouhki/realWebserv/portf;
        cgi_data .py /usr/bin/python3;
        autoindex on;
    }

    location /google {
        root /;
        return 302 /google;
    }

}
