server {
    listen 127.0.0.1:3050;
    root /home/abouhki/Desktop/owebserv;
    methods GET;
    error_page 400 /errors/400.html;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    autoindex on;
    client_max_body_size 5K;

    location / {
        client_max_body_size 20b;
        methods GET DELETE POST;
        authInfo /portf/html/login.html /portf/html/index.html;
        upload_path /server;
        root /home/abouhki/Desktop/owebserv/;
        index gogo.jpg;
        cgi_data .py /usr/bin/python3;
        autoindex on;

    }

    location /portf {
        methods GET POST;
        upload_path /html;
        root /home/abouhki/Desktop/owebserv/portf/;
        index gogo.jpg;
        error_page 400 /errors/400.html;
        error_page 404 /errors/404.html;
        cgi_data .py /usr/bin/python3;
        autoindex on;
    }

    location /errors {
        client_max_body_size 50G;
        methods GET POST DELETE;
        root /;
        upload_path /;
        error_page 400 /errors/400.html;
        error_page 500 /errors/500.html;
        autoindex on;
        return 302 /errors;
    }
    location /google {
        root /;
        return 302 /google;   
    }
}
