server {
    listen 127.0.0.1:3050;
    root /home/abouhki/realWebserv;
    methods GET;
    error_page 400 /errors/400.html;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    error_page 504 /errors/504.html;
    autoindex on;
    client_max_body_size 5K;

    location / {
        index index.html;
        error_page 500 /errors/500.html;
        error_page 400 /errors/400.html;
        client_max_body_size 20m;
        methods GET POST DELETE;
        upload_path /upload;
        root /home/abouhki/;
        cgi_data .py /usr/bin/python3;
        autoindex on;
    }

    location /portf {
        methods GET POST;
        upload_path /html;
        authInfo /portf/html/login.html /portf/html/index.html /portf/html/myProjects.html;
        error_page 400 /errors/400.html;
        error_page 404 /errors/404.html;
        root /home/abouhki/realWebserv/portf;
        cgi_data .py /usr/bin/python3;
        autoindex on;
    }

    location /google {
        root /;
        return 302 /google;   
    }
}
