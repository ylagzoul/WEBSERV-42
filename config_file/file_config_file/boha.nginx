server {
    listen 127.0.0.1:3050;
    root /home/abouhki/Desktop/owebserv;
    methods GET;
    error_page 400 /errors/400.html;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    autoindex on;
    cgi_data .py /usr/bin/python3;

    location / {
        client_max_body_size 100K;
        methods GET DELETE;
        upload_path /goinfre;
        root /home/abouhki/Desktop/owebserv/;
        index index.html gogo.jpg;
        error_page 400 /errors/400.html;
        error_page 404 /errors/404.html;
        autoindex on;
    }

    location /errors {
        client_max_body_size 100G;
        methods GET POST DELETE;
        root /;
        upload_path /;
        error_page 400 /errors/400.html;
        error_page 500 /errors/500.html;
        autoindex on;
        return 302 /errors;
    }
    location /google {
        root /;
        return 302 /google;   
    }
}
