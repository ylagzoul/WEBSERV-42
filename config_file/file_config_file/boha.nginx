server {
    listen 0.0.0.1:8001;
    listen 127.0.0.1;
    listen 65535;
    root /home/boha/Desktop/owebserv/; 
    index indeshx.html;
    methods GET;
    error_page 400 /errors/400.html;
    error_page 403 /errors/403.html;
    error_page 404 /errors/404.html;
    error_page 405 /errors/405.html;
    error_page 500 /errors/500.html;

    location /response {
        methods POST;
        root /home/boha/Desktop/owebserv/response;
        index index.html;
        error_page 400 /errors/400.html;
        error_page 403 /errors/403.html;
        error_page 405 /errors/405.html;
        autoindex off;
    }

    location / {
        methods GET POST DELETE;
        root /home/boha/Desktop/;
        index index.html;
        error_page 400 /errors/400.html;
        error_page 500 /errors/500.html;
        autoindex off;
    }

}