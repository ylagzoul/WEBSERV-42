server {
    listen 127.69.100.1:3050;
    server_name youssef;
    root /home/ylagzoul/Desktop/vv/server/;
    methods GET;
    error_page 401 /errors/401.html;
    error_page 403 /errors/403.html;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    error_page 404 /;
        cgi_data .py /usr/bin/python33;
        cgi_data .py /usr/bin/python55;
        cgi_data .py /usr/bin/python99;

    autoindex on;

    location / {
        methods GET POST DELETE;
        root /home/ylagzoul/Desktop/vv/;
        error_page 405 /errors/405.html;
        error_page 501 /errors/501.html;
        error_page 502 /errors/502.html;
        upload_path server;
        cgi_data .py /usr/bin/python3333;
        cgi_data .py /usr/bin/python555;
        cgi_data .py /usr/bin/python555;
        cgi_data .py /usr/bin/python555;
        cgi_data .py /usr/bin/python888;
        cgi_data .py /usr/bin/python888;
        autoindex on;
    }


}