server {
    listen 127.0.0.1:8080;
    server_name youssef;
    root /home/ylagzoul/Desktop/web/server/;
    methods GET;
    error_page 401 /errors/401.html;
    error_page 403 /errors/403.html;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    error_page 404 /;
    cgi_data .py /usr/bin/python33;
    cgi_data .py2 /usr/bin/python33;
    authInfo /loginpage /page1 /page2 / page3;
    autoindex on;

    location / {
        methods GET POST DELETE;
        root /home/ylagzoul/Desktop/web/;
        error_page 405 /errors/405.html;
        error_page 501 /errors/501.html;
        error_page 502 /errors/502.html;
        upload_path /server;
        autoindex on;
    }


}