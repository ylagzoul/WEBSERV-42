server {
    listen 0.0.0.1:8001;
    listen 127.0.0.1;
    listen 65535;
    root /var/www/main;
    index indeshx.html;
    methods GET POST;
    error_page 500 /errors/500.html;

    location /upload {
        methods POST;
        root /var/www/main;
        index index.html;
        autoindex off;
    }

        location / {
        methods GET POST DELETE;
        root /var/www;
        index index.html;
        autoindex off;
    }

    location /images {
        methods GET;
        root /var/www;
        index index.html;
        autoindex on;
    }

    location /images/upload/images {
        methods GET;
        root /var/www;
        index index.html;
        autoindex on;
    }

    location /images/upload/ {
        methods GET;
        root /var/www;
        index index.html;
        autoindex on;
    }
}