server {
    listen 127.69.100.1:3050;
    server_name youssef;
    root /home/ylagzoul/Desktop/vv/server/;
    methods GET;
    error_page 400 /errors/400.html;
    error_page 403 /errors/403.html;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    error_page 404 /;
    cgi_data .cfi fkdfr.txt;
    autoindex on;

    location /goinfre {
        methods POST GET;
        root /home/ylagzoul/goinfre;
        index index.html gogo.jpg;
        error_page 400 /errors/400.html;
        error_page 403 /errors/403.html;
        error_page 404 /errors/404.html;
        autoindex on;
    }

    location / {
        methods GET POST DELETE;
        root /home/ylagzoul/Desktop/vv/;
        error_page 400 /errors/400.html;
        error_page 500 /errors/500.html;
        upload_path server;
        cgi_data .py /usr/bin/python3;
        autoindex on;
    }


}

