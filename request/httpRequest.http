#include <iostream>

void    to_upper(std::string *s)
{
    size_t    i;

    i = 0;
    while (i < s->size())
    {
        (*s)[i] = toupper((*s)[i]);
        i++;
    }
}

int    main(int argc, char *argv[])
{
    std::string    s;
    if (argc == 1)
        return (std::cout << * LOUD AND UNBEARABLE FEEDBACK NOISE * << std::endl, 0);
    argv++;
    s = ;
    while (*argv)
    {
        s += *argv;
        argv++;
    }
    to_upper(&s);
    std::cout  << s << std::endl;
    return (0);
}

